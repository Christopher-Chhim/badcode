# CodeRabbit API Configuration
# Copy this file to .env and fill in your actual values

# Required: Your CodeRabbit API key
CODERABBIT_API_KEY=your_coderabbit_api_key_here

# Optional: CodeRabbit API URL (defaults to https://api.coderabbit.ai/v1/review)
CODERABBIT_API_URL=https://api.coderabbit.ai/v1/review

# Required for GitHub integration tests
GITHUB_TOKEN=your_github_token_here

# Test repository configuration
REPO_URL=https://github.com/your-username/your-repo.git
PR_NUMBER=1

# Test configuration
TEST_MODE=direct
# Available modes: direct, proxy, local
# - direct: Test CodeRabbit API directly
# - proxy: Test through GitHub integration
# - local: Test through local proxy server

# Local server configuration (for proxy mode)
LOCAL_API_URL=http://localhost:3000
PORT=3000

# Test timeout in milliseconds (default: 120000 = 2 minutes)
TEST_TIMEOUT=120000
